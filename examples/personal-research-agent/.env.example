# 复制为 .env 并填入你的 OpenAI 兼容端点(本地 vLLM/Ollama 或厂商接口)
# 注意:永远不要提交真实密钥到仓库。

# 本地端点示例(vLLM): http://127.0.0.1:8000/v1
# Ollama 示例:          http://127.0.0.1:11434/v1
OPENAI_BASE_URL=http://127.0.0.1:8000/v1

# 本地端点通常不校验 key,但不能留空
OPENAI_API_KEY=sk-your-key-here

# 模型名,与端点暴露的名称一致
MODEL_NAME=your-model-name
